# Copy to `.env` for Docker Compose. NEVER commit real secrets.

# --- Database ---
DB_NAME=hotel_booking
DB_USERNAME=root
DB_PASSWORD=change-me-strong-db-password
DB_PORT=3306

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Production Compose forces prod; keep JWT long & random (32+ bytes)
JWT_SECRET=change-me-in-production-use-at-least-256-bit-secret-key

# --- Frontend (host port) ---
FRONTEND_PORT=80
# Baked into the SPA at image build time (same-origin path preferred)
VITE_API_BASE_URL=/api

# --- Optional ---
APP_VERSION=0.0.1
IMAGE_TAG=latest
# Use Distroless backend image build:
# DOCKERFILE_BACKEND=Dockerfile.backend.distroless
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# --- TLS (docker-compose.tls.yml) ---
# TLS_PORT=443
# Place certs/fullchain.pem and certs/privkey.pem on the host (never commit)

# --- Mail / Razorpay (backend reads APP_* / env — see docs/ENVIRONMENT.md) ---
# APP_MAIL_ENABLED=false
# Local demo:
# APP_RAZORPAY_MOCK_ENABLED=true
# Production (profile=prod): mock must be false + live keys set
# APP_RAZORPAY_MOCK_ENABLED=false
# APP_RAZORPAY_KEY_ID=
# APP_RAZORPAY_KEY_SECRET=
# APP_RAZORPAY_WEBHOOK_SECRET=

# --- Optional first ADMIN (run once, then remove password from env) ---
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin
# APP_BOOTSTRAP_ADMIN_FIRST_NAME=Platform
# APP_BOOTSTRAP_ADMIN_LAST_NAME=Admin

# --- CORS (prod) ---
# APP_CORS_ORIGIN=https://your-frontend.example

# =============================================================================
# Frontend — multi-stage production image (Vite build → Nginx static)
# Build from REPO ROOT so nginx config is available:
#   docker build -f docker/Dockerfile.frontend \
#     --build-arg VITE_API_BASE_URL=/api \
#     -t hotel-booking-frontend .
# =============================================================================

ARG NODE_VERSION=20-alpine
ARG NGINX_VERSION=1.27-alpine

# ----- Stage 1: build SPA -----
FROM node:${NODE_VERSION} AS build
WORKDIR /app

# API base baked at build time (browser calls same-origin /api → Nginx proxy)
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ----- Stage 2: serve static assets -----
FROM nginx:${NGINX_VERSION}
# Remove default site; our conf is the only server block
RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]

# syntax=docker/dockerfile:1
# =============================================================================
# Backend — multi-stage production image (Java 21 / Spring Boot)
#
# BuildKit cache mount keeps ~/.m2 across builds without a fragile go-offline layer.
#
# Build:  docker build -f docker/Dockerfile.backend -t hotel-booking-backend ./backend
# Distroless variant: docker/Dockerfile.backend.distroless
# =============================================================================

# ----- Stage 1: compile -----
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests package \
 && mv target/*.jar /app/app.jar

# ----- Stage 2: runtime (JRE Alpine — good default size/tools balance) -----
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S spring && adduser -S spring -G spring \
 && apk add --no-cache wget \
 && mkdir -p /app /tmp \
 && chown -R spring:spring /app /tmp

USER spring:spring

COPY --from=build --chown=spring:spring /app/app.jar /app/app.jar

EXPOSE 8080

# Writable work dirs when Compose sets read_only: true + tmpfs:/tmp
ENV JAVA_OPTS="-Djava.io.tmpdir=/tmp"

ENTRYPOINT ["sh", "-c", "java -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 $JAVA_OPTS -jar /app/app.jar"]
